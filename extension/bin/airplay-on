#!/bin/sh
# Enable AirPlay: start the (self-installed) raopd.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/airplay-lib.sh"
airplay_config_ensure
export AIRPLAY_NAME="$(airplay_name)"
PREFIX="${AIRPLAY_PREFIX:-/var/local/shairkindle}"
# raopd is self-installed at $PREFIX/raopd by the kindlet shell (PayloadInstaller)
# before the supervisor ever runs this script -- no runtime staging needed.
# Stage markers (>&2 -> supervisor.log) bracket every potentially-blocking step
# so a supervisor "run airplay-on" that never returns shows which command wedged
# (the run_script deadline SIGKILLs it, but the last marker names the culprit).

# WiFi on (default): let raopd prefer wlan0 and open the wlan0 firewall. Users
# can persist WIFI=false for usbnet-only operation.
if [ "$(airplay_wifi_on)" = true ]; then
    echo "[airplay-on] fw_open" >&2
    airplay_fw_open
    echo "[airplay-on] wifi_maxperf" >&2
    airplay_wifi_maxperf                        # disable AR6000 power-save (real-time audio)
else
    echo "[airplay-on] fw_close (wifi off)" >&2
    airplay_fw_close                            # explicit: no stray wlan0 ACCEPT rules
    echo "[airplay-on] wifi_powersave (reconcile)" >&2
    airplay_wifi_powersave                      # reset any maxperf a prior SIGKILL left
    export AIRPLAY_IFACE="${AIRPLAY_IFACE:-usb0}"
fi
echo "[airplay-on] start raopd" >&2

# Run with -f (foreground) so raopd's LOGF diagnostics reach the log -- the
# default daemonize() sends stdio to /dev/null, leaving us blind when it wedges.
# We background it ourselves; `trap "" HUP` makes the child inherit SIG_IGN so it
# survives the KUAL launcher exiting (no setsid/nohup on the K3). raopd still
# writes its own pidfile + flocks against dupes, so don't write $! here (it'd be
# the pre-fork pid and race the daemon's real one).
#
# Log destination: /dev/null unless the user opted into debug logging (see
# airplay-lib.sh DEBUG_FLAG). In debug mode, truncate on start so a session is
# bounded to its own output -- no rotation machinery, and it happens before raopd
# opens the fd so there's no truncate-vs-append race.
if [ "$(airplay_debug_on)" = true ]; then
    LOG="$PREFIX/airplay.log"
    : > "$LOG"
    echo "[airplay-on] debug logging ON ($LOG)" >&2
else
    LOG=/dev/null
fi
trap "" HUP
"$PREFIX/raopd" -f >"$LOG" 2>&1 &
child=$!
# Don't report success until raopd is actually up + has published its pidfile,
# so a fast stop() can't race an unstarted raopd into an orphan. -f => $! is the
# real pid (no daemonize). AIRPLAY_START_TRIES overridable for tests.
tries="${AIRPLAY_START_TRIES:-8}"
i=0
while [ "$i" -lt "$tries" ]; do
    if pid_looks_like_raopd "$child" && [ -f "$PREFIX/raopd.pid" ]; then
        # raopd is up. Give its DACP control socket a brief moment to bind so a
        # button pressed right after open isn't dropped -- best-effort, never
        # fatal (control.sock appears after the iface is up, which can lag).
        [ -S "$PREFIX/control.sock" ] || sleep 1
        echo "[airplay-on] ready (raopd pid=$child)" >&2
        exit 0
    fi
    sleep 1
    i=$((i+1))
done
kill -TERM "$child" 2>/dev/null || true
exit 1
